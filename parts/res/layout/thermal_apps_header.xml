<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/thermal_apps_title"
        android:textAppearance="@style/TextAppearance.SettingsLib.TitleSmall.Emphasized" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/thermal_apps_summary"
        android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
        android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
