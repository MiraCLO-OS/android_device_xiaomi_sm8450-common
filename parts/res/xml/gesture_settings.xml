<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/gestures_title">

    <com.android.settingslib.widget.TopIntroPreference
        android:key="gesture_intro"
        android:title="@string/gestures_intro" />

    <PreferenceCategory
        android:key="gesture_fingerprint_category"
        android:title="@string/gesture_fingerprint_category">

        <ListPreference
            android:key="fp_double_tap"
            android:entries="@array/gesture_action_entries"
            android:entryValues="@array/gesture_action_values"
            android:defaultValue="0"
            android:title="@string/fp_double_tap_title"
            android:summary="%s"
            android:icon="@drawable/ic_fingerprint_24" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="gesture_back_category"
        android:title="@string/gesture_back_category"
        android:summary="@string/back_tap_summary">

        <ListPreference
            android:key="back_double_tap"
            android:entries="@array/gesture_action_entries"
            android:entryValues="@array/gesture_action_values"
            android:defaultValue="0"
            android:title="@string/back_double_tap_title"
            android:summary="%s" />

        <ListPreference
            android:key="back_triple_tap"
            android:entries="@array/gesture_action_entries"
            android:entryValues="@array/gesture_action_values"
            android:defaultValue="0"
            android:title="@string/back_triple_tap_title"
            android:summary="%s" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="gestures_footer"
        android:title="@string/gestures_footer_text"
        android:selectable="false" />

</PreferenceScreen>
